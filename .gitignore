# Upstream CWM, cloned here for reference. It carries its own .git, so adding it
# would commit a gitlink with no .gitmodules — a directory that clones empty.
code-world-model/

# Same situation: its own repo, cloned beside this one. Nothing depends on it
# any more - `clip-prompts` carries its own copy of the client it used to borrow -
# so its absence on a caption node is not a problem to work around.
low_high_pipeline/

# Input corpora and delivered output. Both are mounted or written at runtime and
# neither belongs in the source tree.
handpick29_high_low/
out/

# Weights.
.hf-cache/

# Credentials. `captions` reads a Vertex service-account private key out of
# these, and this repository is public, so the ignore is load-bearing rather
# than tidiness. The committed template is the one exception.
.env
.env.*
!.env.example

# Service-account key files, whatever they got named.
*service-account*.json
*-sa.json

# Local environment.
.venv/
.mplcache/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/*.egg-info/
.DS_Store
