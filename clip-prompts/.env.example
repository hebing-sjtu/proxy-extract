# Credentials for `clip-prompts captions`. Copy to `.env.local` and fill in.
#
# `.env.local` is gitignored. Nothing in this file is read if the same variable
# is already exported, so a node can override one setting without editing it.

# --- Vertex (the default backend) ----------------------------------------
#
# EASIEST: copy the service-account key file onto the node and point at it.
# One line, supplies the project, the email and the key together, and nothing
# has to be escaped.

VERTEX_SA_JSON=/secrets/vertex-sa.json

# The older spelling GOOGLE_APPLICATION_CREDENTIALS works too, so an existing
# export keeps working unchanged.

# OTHERWISE: set the three fields by hand and delete the line above. The
# private key goes on ONE line with its newlines written as \n and the whole
# thing in double quotes - that is what a PEM looks like inside a .env file,
# and it is unescaped again on the way out.
#
# VERTEX_PROJECT_ID=              # VERTEX_PROJECT is accepted as well
# VERTEX_CLIENT_EMAIL=
# VERTEX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional. Defaults to `global`, which is the endpoint without a region prefix.
# VERTEX_LOCATION=us-central1

# --- LiteLLM / any OpenAI-compatible gateway (--backend litellm) ----------
#
# Use this when the node has a gateway but no GCP credentials. Signing is not
# involved, so `openssl` is not needed either.

# LITELLM_BASE_URL=https://gateway.example/v1
# LITELLM_API_KEY=
